{
  "name": "intakegate",
  "version": "1.0.0",
  "private": true,
  "description": "Auditable synthetic intake triage with advisory perception and deterministic review routing",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "triage": "tsx src/index.ts",
    "validate": "tsx src/index.ts validate",
    "schema": "tsx src/index.ts schema",
